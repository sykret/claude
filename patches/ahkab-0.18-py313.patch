+def _finite_eigvals(M, rtol=1e-9):
+    """Eigenvalues of M, dropping the (numerically) null ones.
+
+    A null eigenvalue of a time-constant matrix is a singularity at
+    infinity, so it is discarded instead of triggering a retry."""
+    ev = np.linalg.eigvals(M)
+    if not ev.size:
+        return ev
+    scale = np.max(np.abs(ev))
+    return ev[np.abs(ev) > rtol*scale] if scale else ev[:0]
+
